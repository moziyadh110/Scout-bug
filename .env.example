# local | cloud. Local runs fully offline on fixtures and mocks.
SCOUT_ENV=local
# Optional per-port overrides: SCOUT_LLM=mock|openai, SCOUT_LEDGER=sqlite|solana,
# SCOUT_GITHUB=fixtures|api
SCOUT_LLM=mock
SCOUT_LEDGER=sqlite
SCOUT_GITHUB=fixtures
SCOUT_DATA_DIR=.scout-data

# DigitalOcean Gradient serverless inference (OpenAI-compatible). Open-weight models only.
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_API_KEY=replace-me
# Model IDs: confirm with `uv run scout models` before setting.
MODEL_PLANNER=replace-me
MODEL_CLASSIFIER=replace-me
MODEL_REASONER=replace-me
MODEL_CODER=replace-me

# GitHub (read-only token) and the webhook signing secret
GITHUB_TOKEN=replace-me
GITHUB_WEBHOOK_SECRET=replace-me

# Bounties: test USDC base units (6 decimals). 100000000 = 100 test USDC.
BOUNTY_CAP_UNITS=100000000
BOUNTY_DEADLINE_DAYS=30
# 7 days by default; 180 for the demo
DISPUTE_WINDOW_SECONDS=604800
MIN_DIFF_LINES=3
SANDBOX_TIMEOUT_SECONDS=60
MIN_GAIN=0.05

# Quarantined draft-patch feature
ENABLE_STARTER_PATCH=false

# Solana (cloud mode, devnet only). Escrow is a backend-held wallet: INTERIM design.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ESCROW_KEYPAIR=keys/escrow.keypair.json
SOLANA_FUNDER_KEYPAIR=keys/funder.keypair.json
