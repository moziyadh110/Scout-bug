# local | cloud
FORGE_ENV=local
FORGE_DATA_DIR=.forge-data

# OpenAI-compatible endpoint (cloud mode). Gradient: https://inference.do-ai.run/v1
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_API_KEY=replace-me
# Model IDs: confirm with `uv run forge models` before setting.
MODEL_PLANNER=replace-me
MODEL_CODER=replace-me
MODEL_JUDGE=replace-me
MODEL_REASONER=replace-me

# Bounties
BOUNTY_CAP_LAMPORTS=100000000
BOUNTY_DEADLINE_SECONDS=600
SANDBOX_TIMEOUT_SECONDS=20

# Solana (cloud mode, devnet only)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ESCROW_KEYPAIR=keys/escrow.keypair.json
SOLANA_TREASURY_KEYPAIR=keys/treasury.keypair.json
SOLANA_PAYER_KEYPAIR=keys/payer.keypair.json
